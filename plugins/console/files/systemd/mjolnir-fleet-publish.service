[Unit]
Description=Publish Mjolnir fleet status to Kubernetes
After=network-online.target
Wants=network-online.target
# Publishing needs the fleet credential delivered at provisioning time.
ConditionPathExists=/run/credentials/@system/fleet-kubeconfig

[Service]
Type=oneshot
ImportCredential=fleet-kubeconfig
ImportCredential=role
ExecStart=/usr/bin/mjolnir-fleet publish
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
