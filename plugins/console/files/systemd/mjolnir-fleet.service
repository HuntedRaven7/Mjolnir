[Unit]
Description=Mjolnir fleet Varlink action service
Documentation=https://github.com/HuntedRaven7/Mjolnir/tree/main/plugins/console

[Service]
Type=simple
ImportCredential=role
ExecStart=/usr/bin/mjolnir-fleet varlink
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
StateDirectory=mjolnir
PrivateTmp=yes
