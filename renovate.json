{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "baseBranchPatterns": ["main"],
  "rebaseWhen": "conflicted",
  "platformAutomerge": false,
  "vulnerabilityAlerts": { "enabled": false },
  "schedule": ["after 10pm and before 5am every day"],
  "prConcurrentLimit": 5,
  "timezone": "Etc/UTC",

  "enabledManagers": ["gomod", "github-actions", "custom.regex"],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Kubernetes version; scripts/update_pins.py recomputes the binary sha256 values in CI",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "kubernetes-version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "description": "Bump cri-tools version",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "crictl-version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/cri-tools"
    },
    {
      "customType": "regex",
      "description": "Bump containerd version",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "containerd-version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containerd/containerd"
    },
    {
      "customType": "regex",
      "description": "Bump runc version",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "runc-version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "opencontainers/runc"
    },
    {
      "customType": "regex",
      "description": "Bump CNI plugins version",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "cni-plugins-version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containernetworking/plugins"
    },
    {
      "customType": "regex",
      "description": "Track the pinned kured OCI image digest",
      "managerFilePatterns": ["/include/versions\\.yml$/"],
      "matchStrings": [
        "kured-image-digest:\\s*\"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kubereboot/kured"
    }
  ],

  "postUpgradeTasks": {
    "description": "Recompute sha256 pins for version/digest bumps so version keys and hashes stay in sync in the same PR.",
    "commands": ["python3 scripts/update_pins.py"],
    "fileFilters": ["**/versions.yml"],
    "executionMode": "update"
  },

  "packageRules": [
    {
      "description": "SHA-pin GitHub Actions; only pin/digest bumps auto-merge",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Patch/minor source updates auto-merge after CI; majors need review",
      "matchManagers": ["custom.regex", "gomod"],
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Major source updates always require review",
      "matchManagers": ["custom.regex", "gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep FSDK junction bumps grouped and reviewed",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["elements/freedesktop-sdk.bst"],
      "groupName": "fsdk junction"
    },
    {
      "description": "Group shared action bumps atomically",
      "matchPackageNames": ["projectbluefin/actions/**"],
      "groupName": "projectbluefin actions"
    }
  ]
}
