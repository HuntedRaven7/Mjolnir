[Unit]
Description=Mjolnir installer
# A broken image must not spend 15 minutes in a restart loop. Two attempts are
# enough to prove it is broken; keep the unit failed so the log shows the cause.
StartLimitIntervalSec=120
StartLimitBurst=2
# Do not wait for network-online.target: on a machine with no working network
# that target blocks for ~90s and the installer looks like it never starts.
# A failed install must surface its first error, not a cascade of retries that
# leaves stale filesystem signatures behind.
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/opt/mjolnir-install --yes --config /etc/mjolnir-installer.json
# Do not pin stdin/stdout to /dev/console. Headless VMs and machines where
# /dev/console is not the console being watched made the installer impossible
# to see or drive. Log to the journal AND every console; with no tty on stdin
# the prompt() helper falls back to its default (the first disk), so the
# installer can never block waiting for a console that does not exist.
StandardOutput=journal+console
StandardError=journal+console
Restart=no

[Install]
WantedBy=multi-user.target
