[Unit]
Description=Mjolnir installer
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/opt/mjolnir-install --config /etc/mjolnir-installer.json
StandardInput=tty-force
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
