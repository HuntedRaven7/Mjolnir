[Unit]
Description=Apply pinned Cilium and KubeStellar manifests
After=mjolnir-init.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kubernetes/admin.conf

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s
ExecStart=/usr/bin/mjolnir-helper apply

[Install]
WantedBy=multi-user.target
