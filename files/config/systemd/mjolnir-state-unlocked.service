[Unit]
Description=Report MjolnirState unlock on the serial console
DefaultDependencies=no
After=var-lib-mjolnir.mount
RequiresMountsFor=/var/lib/mjolnir

[Service]
Type=oneshot
RemainAfterExit=yes
# console writes straight to /dev/console. Journal forwarding is not reliable
# during early boot in the VM, so the needle must bypass journald entirely.
ExecStart=/usr/bin/echo MjolnirState: unlocked
StandardOutput=console
StandardError=console

[Install]
WantedBy=local-fs.target
