[Unit]
Description=Persistent Mjolnir state (LUKS-backed btrfs)
DefaultDependencies=no
Conflicts=umount.target
After=cryptsetup.target
Before=local-fs.target umount.target

[Mount]
What=/dev/disk/by-label/MjolnirState
Where=/var/lib/mjolnir
Type=btrfs
Options=subvol=/,rw,noatime

[Install]
WantedBy=local-fs.target
