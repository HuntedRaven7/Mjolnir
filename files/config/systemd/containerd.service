[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target local-fs.target

[Service]
ExecStartPre=/usr/bin/mkdir -p /etc/containerd /var/lib/containerd
ExecStartPre=/usr/bin/cp -n /usr/share/mjolnir/containerd/config.toml /etc/containerd/config.toml
ExecStart=/usr/bin/containerd --config /etc/containerd/config.toml
Restart=always
RestartSec=2s
Delegate=yes
KillMode=process
TasksMax=infinity
LimitNOFILE=1048576
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
