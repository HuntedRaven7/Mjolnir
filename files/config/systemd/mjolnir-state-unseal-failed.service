[Unit]
Description=Report a TPM2 PCR policy unseal failure on the serial console
DefaultDependencies=no

[Service]
Type=oneshot
# The failure happens in the initramfs, before switch-root. Both needles are
# emitted by systemd itself, not by a shell or interpreter.
ExecStart=/usr/bin/echo PCR policy
ExecStart=/usr/bin/echo Failed to unseal
StandardOutput=journal+console
StandardError=journal+console
