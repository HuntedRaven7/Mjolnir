[Unit]
Description=Report a TPM2 PCR policy unseal failure on the serial console
DefaultDependencies=no

[Service]
Type=oneshot
# The failure happens in the initramfs, before switch-root. Both needles go
# straight to /dev/console; journald forwarding is not available yet.
ExecStart=/usr/bin/echo PCR policy
ExecStart=/usr/bin/echo Failed to unseal
StandardOutput=console
StandardError=console
